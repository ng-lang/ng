{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 1 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (default build/ tree)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "asan",
      "displayName": "ASan+UBSan (INC-0 leak/memory baseline)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "NG_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" }
  ]
}
