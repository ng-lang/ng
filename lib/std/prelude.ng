// vNext std.prelude: printing, assertions, and basic predicates.

import io;
import string;

export native fun print(value: i64) -> unit;
export native fun print(value: string) -> unit;
export native fun print(value: bool) -> unit;
export native fun print(value: f64) -> unit;
export native fun print(value: f32) -> unit;
export native fun print(value: u8) -> unit;
export native fun print(value: u16) -> unit;
export native fun print(value: u32) -> unit;
export native fun print(value: u64) -> unit;
export native fun assert(condition: bool) -> unit;

// Compiles and runs an NG source unit inside the running program, returning
// its captured output (and diagnostics with a trailing `[exit N]` on failure).
export native fun runNgi(source: string) -> string;

export fun not(value: bool) -> bool {
    return !value;
}

export const is_ref<T>: bool = false;
export const<T> is_ref<ref<T>>: bool = true;
