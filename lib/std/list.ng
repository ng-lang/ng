// vNext std.list (redesign, legacy 59 spirit): a read-only recursive sequence
// over the recursive-enum List<T>; node construction uses caller bindings and
// scoped refs, and mutating builders arrive with the R6 heap domain.

import prelude;
import seq;

export enum List<T> {
    Cons(head: T, tail: ref<List<T>>),
    Nil,
}

export fun length<T>(list: ref<List<T>>) -> i64 {
    switch (*list) {
        case Nil { return 0; }
        case Cons(value, rest) { return 1 + length(rest); }
    }
}

export fun get<T>(list: ref<List<T>>, index: i64) -> T {
    switch (*list) {
        case Nil {
            assert(false);
            return get(list, index);
        }
        case Cons(value, rest) {
            if (index == 0) { return value; }
            return get(rest, index - 1);
        }
    }
}

export fun contains<T>(list: ref<List<T>>, value: T) -> bool {
    switch (*list) {
        case Nil { return false; }
        case Cons(head, rest) { return head == value || contains(rest, value); }
    }
}

// Immutable builders (redesign of legacy 59's listof/pushBack/append):
// each call rebuilds the sequence over the recursive enum, sharing cells
// through scoped refs. Mutating in-place builders arrive with the R6 heap
// domain.

fun listFromInner<T>(values: array<T>, index: i64) -> List<T> {
    if (index == len(values)) {
        let empty: List<T> = List.Nil;
        return empty;
    }
    let rest = listFromInner(values, index + 1);
    return List.Cons(values[index], ref rest);
}

/// Builds a List from an array (`listFrom([1, 2, 3])`).
export fun listFrom<T>(values: array<T>) -> List<T> {
    return listFromInner(values, 0);
}

/// Prepends a value (`pushFront(ref list, 1)`).
export fun pushFront<T>(list: ref<List<T>>, value: T) -> List<T> {
    let tail = *list;
    return List.Cons(value, ref tail);
}

/// Appends a value (`append(ref list, 9)`).
export fun append<T>(list: ref<List<T>>, value: T) -> List<T> {
    switch (*list) {
        case Nil {
            let tail = *list;
            return List.Cons(value, ref tail);
        }
        case Cons(head, rest) {
            let appended = append(rest, value);
            return List.Cons(head, ref appended);
        }
    }
}

/// Reverses a list.
export fun reverseList<T>(list: ref<List<T>>) -> List<T> {
    switch (*list) {
        case Nil {
            let empty = *list;
            return empty;
        }
        case Cons(head, rest) {
            let reversed = reverseList(rest);
            return append(ref reversed, head);
        }
    }
}
