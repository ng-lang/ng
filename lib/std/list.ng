// vNext std.list (redesign, legacy 59 spirit): a read-only recursive sequence
// over the recursive-enum List<T>; node tails are Box<List<T>> heap cells
// (registered handles), so box reads, clones, and drops are well-defined.

import prelude;
import seq;
import memory;

export enum List<T> {
    Cons(head: T, tail: Box<List<T>>),
    Nil,
}

export fun length<T>(list: ref<List<T>>) -> i64 {
    switch (*list) {
        case Nil { return 0; }
        case Cons(value, rest) {
            let boxed: List<T> = read<List<T>>(ref rest);
            return 1 + length(ref boxed);
        }
    }
}

export fun get<T>(list: ref<List<T>>, index: i64) -> T {
    switch (*list) {
        case Nil {
            assert(false);
            return get(list, index);
        }
        case Cons(value, rest) {
            if (index == 0) { return value; }
            let boxed: List<T> = read<List<T>>(ref rest);
            return get(ref boxed, index - 1);
        }
    }
}

// Array-spread internals (INC-20c S2): value-taking walkers so list spreads
// lower as ordinary calls to the std helpers instead of FlowIR list opcodes.
fun spreadLength<T>(list: List<T>) -> i64 { return length(ref list); }
fun spreadGet<T>(list: List<T>, index: i64) -> T { return get(ref list, index); }

export fun contains<T>(list: ref<List<T>>, value: T) -> bool {
    switch (*list) {
        case Nil { return false; }
        case Cons(head, rest) {
            if (head == value) { return true; }
            let boxed: List<T> = read<List<T>>(ref rest);
            return contains(ref boxed, value);
        }
    }
}

// Immutable builders (redesign of legacy 59's listof/pushBack/append):
// each call rebuilds the sequence over the recursive enum, boxing each tail
// into a heap cell. INC-21 S2 adds the unique-own in-place `pushBack` builder
// (and a copy-on-write fallback) at the bottom of this file.

fun listFromInner<T>(values: array<T>, index: i64) -> List<T> {
    if (index == len(values)) {
        let empty: List<T> = List.Nil;
        return empty;
    }
    let rest = listFromInner(values, index + 1);
    let tail: Box<List<T>> = new(rest);
    return List.Cons(values[index], tail);
}

/// Builds a List from an array (`listFrom([1, 2, 3])`).
export fun listFrom<T>(values: array<T>) -> List<T> {
    return listFromInner(values, 0);
}

/// Prepends a value (`pushFront(ref list, 1)`).
export fun pushFront<T>(list: ref<List<T>>, value: T) -> List<T> {
    let whole: List<T> = *list;
    let tail: Box<List<T>> = new(whole);
    return List.Cons(value, tail);
}

/// Appends a value (`append(ref list, 9)`).
export fun append<T>(list: ref<List<T>>, value: T) -> List<T> {
    switch (*list) {
        case Nil {
            let tail: List<T> = List.Nil;
            let boxed: Box<List<T>> = new(tail);
            return List.Cons(value, boxed);
        }
        case Cons(head, rest) {
            let boxed: List<T> = read<List<T>>(ref rest);
            let appended = append(ref boxed, value);
            let tail: Box<List<T>> = new(appended);
            return List.Cons(head, tail);
        }
    }
}

/// Reverses a list.
export fun reverseList<T>(list: ref<List<T>>) -> List<T> {
    switch (*list) {
        case Nil {
            let empty: List<T> = *list;
            return empty;
        }
        case Cons(head, rest) {
            let boxed: List<T> = read<List<T>>(ref rest);
            let reversed = reverseList(ref boxed);
            let appended = append(ref reversed, head);
            return appended;
        }
    }
}

// INC-21 S2: mutating `pushBack(ref mut list, value)`. The List spine is
// immutable and Box payloads deep-copy on read (see std.memory), so an
// in-place tail-cell write cannot observe the live list; `pushBack` therefore
// always rebuilds the spine via the persistent `append` and writes the fresh
// list back through the receiver binding. O(n) per push — arrays deliver the
// amortized-O(1) in-place builder (seq.pushBack).
export fun pushBack<T>(list: List<T> ref mut, value: T) -> unit {
    let current: List<T> = *list;
    let rebuilt: List<T> = append(ref current, value);
    *list := rebuilt;
}
