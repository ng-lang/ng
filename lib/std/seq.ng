// vNext std.seq (redesign): array helpers as free functions over value-typed
// arrays. The legacy Sequence trait abstraction is unnecessary: arrays already
// carry len, indexing, comprehensions, folds, and slices in the language.

export native fun len<T>(values: array<T>) -> i64;
export native fun sum(values: array<i64>) -> i64;
export native fun arrayContains(values: array<i64>, value: i64) -> bool;
export native fun reverse(values: array<i64>) -> array<i64>;

// INC-21 S2: mutate-and-grow append for a uniquely-owned array binding
// (`pushBack(ref mut xs, value)`). When a copy of the binding exists the
// checker routes the call to a copy-on-write helper, so array value semantics
// always hold; a unique receiver grows amortized O(1) on the arena.
export native fun pushBack<T>(values: array<T> ref mut, value: T) -> unit;

// INC-14 S2c: higher-order map. `f` is a closure typed against the element and
// result type parameter; a call passing a closure literal is re-checked as a
// closure-specialized instance in which `f(values[i])` binds to the literal's
// synthesized code function.
export fun map<T, U>(values: array<T>, f: |T| -> U) -> array<U> {
    let mut result: array<U> = [];
    let mut index = 0;
    while (index < len(values)) {
        result := result << f(values[index]);
        index := index + 1;
    }
    return result;
}

// INC-14 S5: higher-order filter and fold (non-escaping closure combinators).
// `filter` keeps elements for which `pred` returns true; `fold` threads an
// accumulator left-to-right through `f(acc, element)`.
export fun filter<T>(values: array<T>, pred: |T| -> bool) -> array<T> {
    let mut result: array<T> = [];
    let mut index = 0;
    while (index < len(values)) {
        if (pred(values[index])) {
            result := result << values[index];
        }
        index := index + 1;
    }
    return result;
}

export fun fold<T, U>(values: array<T>, initial: U, f: |U, T| -> U) -> U {
    let mut acc = initial;
    let mut index = 0;
    while (index < len(values)) {
        acc := f(acc, values[index]);
        index := index + 1;
    }
    return acc;
}
