# Runtime helper extracted from src/native/lowering.cpp (ARCH-1);
# assembled once at build time into libngrt_helpers.a.

export function l $ngrt_arr_addr(l %a, l %i) {
@start
	%len =l loadl %a
	%neg =w csltl %i, 0
	%high =w csgel %i, %len
	%bad =w or %neg, %high
	jnz %bad, @halt, @ok
@halt
	hlt
@ok
	%off =l mul %i, 8
	%base =l add %a, 16
	%addr =l add %base, %off
	ret %addr
}

export function l $ngrt_arr_get(l %a, l %i) {
@start
	%addr =l call $ngrt_arr_addr(l %a, l %i)
	%v =l loadl %addr
	ret %v
}

export function l $ngrt_arr_append(l %a, l %e) {
@start
	%len =l loadl %a
	%n =l add %len, 1
	%total =l mul %n, 8
	%total =l add %total, 16
	%p =l call $ngrt_alloc(l %total)
	storel %n, %p
	%cap =l add %p, 8
	storel %n, %cap
	%dst =l add %p, 16
	%src =l add %a, 16
	%oldsize =l mul %len, 8
	%m =l call $memcpy(l %dst, l %src, l %oldsize)
	%last =l add %dst, %oldsize
	storel %e, %last
	ret %p
}

export function l $ngrt_arr_slice(l %a, l %s, l %e) {
@start
	%len =l loadl %a
	%sneg =w csltl %s, 0
	%shigh =w csgel %s, %e
	%ehigh =w csgtl %e, %len
	%bad =w or %sneg, %shigh
	%bad =w or %bad, %ehigh
	jnz %bad, @halt, @ok
@halt
	hlt
@ok
	%n =l sub %e, %s
	%size =l mul %n, 8
	%total =l add %size, 16
	%p =l call $ngrt_alloc(l %total)
	storel %n, %p
	%cap =l add %p, 8
	storel %n, %cap
	%dst =l add %p, 16
	%off =l mul %s, 8
	%src =l add %a, 16
	%src =l add %src, %off
	%m =l call $memcpy(l %dst, l %src, l %size)
	ret %p
}

export function l $ngrt_arr_clone_words(l %src) {
@start
	%len =l loadl %src
	%size =l mul %len, 8
	%total =l add %size, 16
	%p =l call $ngrt_alloc(l %total)
	storel %len, %p
	%cap =l add %p, 8
	storel %len, %cap
	%dst =l add %p, 16
	%srcp =l add %src, 16
	%m =l call $memcpy(l %dst, l %srcp, l %size)
	ret %p
}

export function l $ngrt_arr_clone_strings(l %src) {
@start
	%len =l loadl %src
	%size =l mul %len, 8
	%total =l add %size, 16
	%p =l call $ngrt_alloc(l %total)
	storel %len, %p
	%cap =l add %p, 8
	storel %len, %cap
	%i =l copy 0
@loop
	%done =w csgel %i, %len
	jnz %done, @end, @copy
@copy
	%v =l call $ngrt_arr_get(l %src, l %i)
	%c =l call $ngrt_str_clone(l %v)
	%off =l mul %i, 8
	%base =l add %p, 16
	%addr =l add %base, %off
	storel %c, %addr
	%i =l add %i, 1
	jmp @loop
@end
	ret %p
}

export function l $ngrt_copy_elements(l %dst, l %src, l %count) {
@start
	%i =l copy 0
@loop
	%done =w csgel %i, %count
	jnz %done, @end, @copy
@copy
	%v =l call $ngrt_arr_get(l %src, l %i)
	%off =l mul %i, 8
	%addr =l add %dst, %off
	storel %v, %addr
	%i =l add %i, 1
	jmp @loop
@end
	ret %dst
}

