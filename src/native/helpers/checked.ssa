# Runtime helper extracted from src/native/lowering.cpp (ARCH-1);
# assembled once at build time into libngrt_helpers.a.

export function l $ngrt_panic() {
@start
	hlt
}

export function l $ngrt_checked_add(l %a, l %b) {
@start
	%r =l add %a, %b
	%ap =w csgtl %a, 0
	%bp =w csgtl %b, 0
	%rn =w cslel %r, 0
	%an =w csltl %a, 0
	%bn =w csltl %b, 0
	%rz =w csgel %r, 0
	%o1 =w and %ap, %bp
	%o1 =w and %o1, %rn
	%o2 =w and %an, %bn
	%o2 =w and %o2, %rz
	%ov =w or %o1, %o2
	jnz %ov, @halt, @ok
@halt
	hlt
@ok
	ret %r
}

export function l $ngrt_checked_uadd(l %a, l %b) {
@start
	%r =l add %a, %b
	%ov =w cultl %r, %a
	jnz %ov, @halt, @ok
@halt
	hlt
@ok
	ret %r
}

