	%rn =w csltl %r, 0
	%an =w csltl %a, 0
	%bp =w csgtl %b, 0
	%rz =w csgel %r, 0
	%o1 =w and %ap, %bn
	%o1 =w and %o1, %rn
	%o2 =w and %an, %bp
	%o2 =w and %o2, %rz
