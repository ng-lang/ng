@halt
	hlt
@ok
	%r =l sub %a, %b
	ret %r
}

export function l $ngrt_checked_mul(l %a, l %b) {
@start
	%r =l mul %a, %b
	%bz =w ceql %b, 0
	%bm1 =w ceql %b, -1
	%amin =w ceql %a, -9223372036854775808
	%edge =w and %bm1, %amin
	%skip =w or %bz, %edge
	%neg =w ceqw %skip, 0
	jnz %neg, @check, @ok
@check
	%q =l div %r, %b
	%same =w ceql %q, %a
	jnz %same, @ok, @halt
@halt
	hlt
@ok
	ret %r
}

export function l $ngrt_checked_umul(l %a, l %b) {
@start
	%r =l mul %a, %b
	%bz =w ceql %b, 0
	jnz %bz, @ok, @check
@check
	%q =l udiv %r, %b
	%same =w ceql %q, %a
	jnz %same, @ok, @halt
@halt
	hlt
@ok
	ret %r
}

export function l $ngrt_checked_div(l %a, l %b) {
@start
