// NG IDE: a minimal editor-and-runner built on the std.imgui binding.
//
// Run with:
//   ./build/ngi example/ng_ide.ng
//
// The editor is an AOT smoke test: the imgui natives are headless libngrt
// stubs, and Run compiles the editor source on top of std.system by locating
// `ngi` in PATH or the current directory.

import prelude;
import imgui;
import system;
import io;

fun main() -> unit {
    let mut source = "fun main() -> i64 {\n    return 42;\n}\n";
    let mut output = "NG IDE ready. Edit the source, then press Run.";
    let mut dark = false;

    imguiInit();
    imguiStyleColorsLight();

    loop (frame = 0) {
        imguiEventLoop();
        imguiNewFrame();

        imguiSetNextWindowSize(1100.0, 720.0);
        imguiBegin("NG IDE");

        imguiTextWrapped("NG IDE: AOT-native imgui stubs. Press Run to compile via ngi.");

        if (imguiButton("Run")) {
            let sourcePath = "/tmp/ng_ide_source.ng";
            writeFile(sourcePath, source);
            let probe = trim(systemOutput("if test -x ./ngi; then echo ./ngi; elif command -v ngi >/dev/null 2>&1; then echo ngi; fi"));
            if (length(probe) == 0) {
                output := "error: cannot find ngi executable in PATH or current directory";
            } else {
                output := systemOutput(probe + " " + sourcePath);
            }
        }
        if (imguiButton("Reset")) {
            source := "fun main() -> i64 {\n    return 42;\n}\n";
            output := "Source reset.";
        }
        if (imguiCheckbox("Dark theme", dark)) {
            dark := true;
            imguiStyleColorsDark();
        } else {
            dark := false;
            imguiStyleColorsLight();
        }

        imguiSeparator();
        imguiTextWrapped("Source (fun main() -> i64 { return 42; })");
        imguiBeginChild("editor", 0.0, 380.0);
        source := imguiInputTextMultiline("##source", source, 0.0, 360.0);
        imguiEndChild();

        imguiSeparator();
        imguiTextWrapped("Output");
        imguiBeginChild("output", 0.0, 170.0);
        imguiTextWrapped(output);
        imguiEndChild();

        imguiEnd();
        imguiRender();

        if (not(imguiAborted())) {
            next (frame + 1);
        }
    }

    imguiCleanup();
}
