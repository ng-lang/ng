// NG IDE: a minimal editor-and-runner built on the std.imgui binding.
//
// Run with:
//   ./build/ngi example/ng_ide.ng
//
// The editor runs on the SDL3 GPU / Dear ImGui backend, and Run compiles the
// editor source through the real pipeline by invoking the ngi frontend
// (./build/ngi, ./ngi, or ngi on PATH) on a unique temporary source file.

import prelude;
import imgui;
import system;
import io;

fun main() -> unit {
    let mut source = "fun main() -> i64 {\n    return 42;\n}\n";
    let mut output = "NG IDE ready. Edit the source, then press Run.";
    let mut dark = false;

    imguiInit();
    imguiStyleColorsLight();

    loop (frame = 0) {
        imguiEventLoop();
        imguiNewFrame();

        imguiSetNextWindowSize(1100.0, 720.0);
        imguiBegin("NG IDE");

        imguiTextWrapped("NG IDE: SDL3 GPU imgui backend. Press Run to compile via the running ngi.");

        if (imguiButton("Run")) {
            let sourcePath = trim(systemOutput("mktemp /tmp/ng_ide_source_XXXXXX"));
            if (length(sourcePath) == 0) {
                output := "error: mktemp failed: cannot create a temporary source file";
            } else {
                writeFile(sourcePath, source);
                // The running process is the compiled IDE executable, not the
                // frontend, so probe the documented ./build/ngi launch path
                // first, then ./ngi, then ngi on PATH.
                let probe = trim(systemOutput("if test -x ./build/ngi; then echo ./build/ngi; elif test -x ./ngi; then echo ./ngi; elif command -v ngi >/dev/null 2>&1; then echo ngi; fi"));
                if (length(probe) == 0) {
                    output := "error: cannot find ngi executable (./build/ngi, ./ngi, or PATH)";
                } else {
                    // Quote both paths for /bin/sh -c (single quotes with the
                    // embedded-quote escape) so spaces in the executable path
                    // do not get shell-parsed.
                    let command = "'" + replace(probe, "'", "'\\''") + "' '" + replace(sourcePath, "'", "'\\''") + "'";
                    output := systemOutput(command);
                }
                system("rm -f '" + replace(sourcePath, "'", "'\\''") + "'");
            }
        }
        if (imguiButton("Reset")) {
            source := "fun main() -> i64 {\n    return 42;\n}\n";
            output := "Source reset.";
        }
        if (imguiCheckbox("Dark theme", dark)) {
            dark := true;
            imguiStyleColorsDark();
        } else {
            dark := false;
            imguiStyleColorsLight();
        }

        imguiSeparator();
        imguiTextWrapped("Source (fun main() -> i64 { return 42; })");
        imguiBeginChild("editor", 0.0, 380.0);
        source := imguiInputTextMultiline("##source", source, 0.0, 360.0);
        imguiEndChild();

        imguiSeparator();
        imguiTextWrapped("Output");
        imguiBeginChild("output", 0.0, 170.0);
        imguiTextWrapped(output);
        imguiEndChild();

        imguiEnd();
        imguiRender();

        if (not(imguiAborted())) {
            next (frame + 1);
        }
    }

    imguiCleanup();
}
