// INC-14 slices S1-S2c: closures with explicit parameter types, direct calls,
// expected-type-driven untyped parameter inference, `||` zero-parameter
// heads, and higher-order functions: closure-typed parameters specialize per
// concrete closure argument so f(x) calls bind to the literal's code function.
// Captures and fully generic closures arrive in later slices (S3-S4).
import prelude;
import seq;

fun apply(x: i64) -> i64 {
    let doubler = |v: i64| v * 2;
    return doubler(x);
}

fun twice(f: |i64| -> i64, x: i64) -> i64 {
    return f(f(x));
}

fun invokes(f: |i64| -> i64, x: i64) -> i64 {
    return f(x);
}

fun main() -> i64 {
    let add = |a: i64, b: i64| a + b;
    let mul = |a: i64, b: i64| { let c = a * b; c + 1 };
    let identity = |x: i64| x;
    let plan = |x: i64| { let y = x - 1; y * y };
    let double: |i64| -> i64 = |x| x * 2;          // S2: expected-type driven
    let pair: |i64, i64| -> i64 = |a, b| a + b;    // S2: multi-param inference
    let fortyTwo = || 42;                          // S2: zero-parameter head
    print(add(2, 3));
    print(mul(5, 6));
    print(identity(7));
    print(plan(5));
    print(apply(21));
    print(double(21));
    print(pair(4, 38));
    print(fortyTwo());
    print(invokes(|v| v + 1, 41));                 // S2c: closure literal arg
    print(invokes(double, 41));                    // S2c: closure-typed local arg
    print(twice(|v| v * 2, 21));                   // S2c: non-generic higher-order
    print(twice(|v| v + 1, 20));                   // S2c: distinct closure instance
    let xs = [1, 2, 3, 4];
    let doubled = map(xs, |x| x * 2);              // S2c: std.seq map<T,U>
    print(doubled[0] + doubled[1] + doubled[2] + doubled[3]);
    return 0;
}