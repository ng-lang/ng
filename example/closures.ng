// INC-14 slices S1-S2: closures with explicit parameter types, direct calls,
// expected-type-driven untyped parameter inference, and `||` zero-parameter
// heads. Captures and generic closures arrive in later slices (S3-S4/S2c).
import prelude;

fun apply(x: i64) -> i64 {
    let doubler = |v: i64| v * 2;
    return doubler(x);
}

fun main() -> i64 {
    let add = |a: i64, b: i64| a + b;
    let mul = |a: i64, b: i64| { let c = a * b; c + 1 };
    let identity = |x: i64| x;
    let plan = |x: i64| { let y = x - 1; y * y };
    let double: |i64| -> i64 = |x| x * 2;          // S2: expected-type driven
    let pair: |i64, i64| -> i64 = |a, b| a + b;    // S2: multi-param inference
    let fortyTwo = || 42;                          // S2: zero-parameter head
    print(add(2, 3));
    print(mul(5, 6));
    print(identity(7));
    print(plan(5));
    print(apply(21));
    print(double(21));
    print(pair(4, 38));
    print(fortyTwo());
    return 0;
}