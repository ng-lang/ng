// vNext string conversions and integer parsing (INC-7): toString mirrors the
// print formatters, and parseInt returns a Result value instead of trapping
// on bad input.
import prelude;

fun show(value: i64) -> string {
    return "n=" + toString(value);
}

fun main() -> unit {
    // Formatting across widths and kinds.
    print(show(42));
    print(show(-7));
    print(toString(true) + "/" + toString(false));
    print(toString(2.5));

    // Safe parsing: Result-style value instead of a trap.
    switch (parseInt("123")) {
        case Ok(value) { print(value == 123); }
        case Err(text) { print(false); }
    }

    // Boundary values survive the round trip exactly.
    let min = -9223372036854775807 - 1;
    let max = 9223372036854775807;
    switch (parseInt(toString(min))) {
        case Ok(value) { print(value == min); }
        case Err(text) { print(false); }
    }
    switch (parseInt(toString(max))) {
        case Ok(value) { print(value == max); }
        case Err(text) { print(false); }
    }

    // Invalid inputs report false rather than trapping...
    print(canParseInt("12abc"));
    // ...and the raw parser traps (kept in int-parse-invalid.trap.ng).
}
