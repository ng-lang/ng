type MyResult = Success(value: i32) | Failure(msg: string);

val success = Success(42);
val failure = Failure("something went wrong");

switch (success) {
    case Success(value) {
        print(value);
    }
    case Failure(msg) {
        print(msg);
    }
}

switch (failure) {
    case Success(value) {
        print(value);
    }
    case Failure(msg) {
        print(msg);
    }
}

// Property access on tagged union values
print(success.tag);    // "Ok"
print(success.index);  // 0
print(failure.tag);    // "Err"
print(failure.index);  // 1

// Exhaustiveness: otherwise branch
switch (success) {
    case Success(value) {
        print(value);
    }
    otherwise {
        print("unreachable");
    }
}