// vNext array append (legacy 52's `<<`, value semantics): `xs << value`
// returns a new array with the element appended; the receiver is unchanged.
// Integer `<<` keeps its bitwise-shift meaning.

import prelude;

fun main() -> unit {
    let xs = [1, 2, 3];
    let longer = xs << 9;
    assert(xs[0] == 1);
    assert(xs[2] == 3);
    assert(longer[3] == 9);

    // Chains through rebinding.
    let mut acc = [1];
    acc := acc << 2 << 3;
    assert(acc[0] == 1);
    assert(acc[1] == 2);
    assert(acc[2] == 3);

    // Shifts stay bitwise on integers.
    let shifted = 1 << 3;
    assert(shifted == 8);
}
