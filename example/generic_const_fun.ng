// vNext generic const funs: compile-time calls over type parameters with
// trait-bound where clauses, evaluated per concrete instance; abstract
// calls inside generic bodies defer to monomorphization.

import prelude;

trait Show {
    fun show(self: Self ref) -> string;
}

impl Show for i64 {
    fun show(self: Self ref) -> string {
        return "int";
    }
}

const fun is_showable<T>() -> bool where T: Show {
    return true;
}

const fun identity<T>(value: T) -> T {
    return value;
}

fun classify<U: Show>() -> i64 {
    const if (is_showable<U>()) { return 1; }
    return 0;
}

fun main() -> unit {
    // Explicit type arguments, folded at compile time.
    const if (is_showable<i64>()) { print("i64 showable"); } else { assert(false); }

    // Inferred type arguments reuse the runtime-instantiated body.
    const if (identity(7) == 7) { print("identity folded"); } else { assert(false); }

    // Per-instance const if over a trait-bound type parameter.
    assert(classify<i64>() == 1);

    // Generic const funs stay runtime-callable.
    assert(identity("ok") == "ok");
}
